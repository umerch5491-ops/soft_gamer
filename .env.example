NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public API Credentials (Phase 2)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Search Console Verification (Phase 4 SEO)
# Obtain from Google Search Console -> Settings -> Ownership verification -> HTML tag method
# Copy only the content="..." value, not the full tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense (Phase 4 — set to false until AdSense is approved)
# When AdSense is approved, set to true and add your publisher ID below.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
